            "at": "c-cache",
            "do": "show",
            "targets": [
              "cache"
            ]
          },
          {
            "at": "c-db",
            "do": "show",
            "targets": [
              "db"
            ]
          }
        ]
      }
    },
    {
      "id": "hit",
      "choreo": "flow",
      "beats": [
        {
          "say": "Most of the time, the cache {has it|c-hit}. That's a hit. It comes back in about a millisecond, and the database {never hears about it|c-never}."
        }
      ],
      "scene": {
        "type": "diagram",
        "diagram": "cache",
        "actions": [
          {
            "at": "start+0.2",
            "do": "flow",
            "path": [
              "users",
              "api",
              "cache"
