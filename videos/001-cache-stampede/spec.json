    },
    {
      "id": "build",
      "choreo": "build",
      "beats": [
        {
          "say": "A request {arrives|c-users} at your {app server|c-api}."
        },
        {
          "say": "Before touching the database, the app asks the {cache|c-cache}: do you already have this?"
        },
        {
          "say": "The {database|c-db} is only the fallback. [pause 0.3]"
        }
      ],
      "scene": {
        "type": "diagram",
        "diagram": "cache",
