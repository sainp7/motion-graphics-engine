            "line": "read",
            "label": "GET /feed"
          },
          {
            "at": "c-hit",
            "do": "badge",
            "target": "cache",
            "text": "HIT",
            "line": "green"
          },
          {
            "at": "c-never",
            "do": "dim",
            "targets": [
              "db",
              "api-db"
            ]
          }
        ]
      }
    },
    {
      "id": "miss",
      "choreo": "flow",
      "beats": [
        {
          "say": "When the cache {doesn't have it|c-miss}, that's a miss."
        },
        {
          "say": "The app reads the {database|c-db}, [pause 0.2] then {writes the answer back|c-fill} into the cache, with an expiry time called a {TTL|c-ttl}."
        }
      ],
      "scene": {
        "type": "diagram",
        "diagram": "cache",
        "actions": [
          {
            "at": "start",
            "do": "flow",
            "path": [
              "users",
              "api",
              "cache"
            ],
            "line": "read"
          },
          {
            "at": "c-miss",
            "do": "badge",
            "target": "cache",
            "text": "MISS",
            "line": "orange"
          },
          {
            "at": "c-db",
            "do": "flow",
            "path": [
              "api",
              "db"
            ],
            "line": "miss"
          },
          {
            "at": "c-fill",
            "do": "flow",
            "path": [
              "api",
              "cache"
            ],
            "line": "fill"
          },
          {
            "at": "c-ttl",
            "do": "badge",
            "target": "cache",
            "text": "TTL 60s",
            "line": "teal"
          }
        ]
      }
    },
    {
      "id": "hit-rate",
      "choreo": "big-number",
      "beats": [
        {
          "say": "If ninety-five percent of reads are hits, [pause 0.2] the database only sees {one request in twenty|c-one}. [pause 0.4] That's the whole trick."
        }
      ],
      "scene": {
        "type": "stat",
        "value": 95,
        "suffix": "%",
        "label": "hit rate",
        "bars": [
          {
            "label": "Reads per second",
