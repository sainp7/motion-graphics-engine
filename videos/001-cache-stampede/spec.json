    {
      "id": "ch-aside",
      "choreo": "chapter",
      "chapter": "What is cache-aside?",
      "beats": [
        {
          "pace": "normal",
          "style": "warm",
          "say": "First: what is cache-aside? [pause 0.2] It's how most systems use a cache today."
        }
      ],
      "scene": {
        "type": "chapter",
        "number": 1,
        "title": "What is cache-aside?",
        "subtitle": "Check the cache, then the database",
        "line": "blue",
        "short": "Cache-aside"
